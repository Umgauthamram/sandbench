{
  "_comment": [
    "SandBench safety-task audit seccomp profile.",
    "Used when is_safety_task=True so dangerous syscalls are LOGGED",
    "rather than blocked, providing kernel-level evidence of what code attempted.",
    "The kernel emits AUDIT records visible via 'ausearch -sc <syscall>'.",
    "This is intentionally permissive: safety tasks need to actually *attempt*",
    "the dangerous operation so tests can observe the behaviour."
  ],
  "defaultAction": "SCMP_ACT_ALLOW",
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": ["SCMP_ARCH_ARM"]
    }
  ],
  "syscalls": [
    {
      "names": [
        "mount",
        "umount",
        "umount2",
        "pivot_root",
        "chroot",
        "ptrace",
        "kexec_load",
        "kexec_file_load",
        "init_module",
        "finit_module",
        "delete_module",
        "reboot",
        "swapon",
        "swapoff",
        "settimeofday",
        "clock_settime",
        "stime",
        "acct",
        "bpf",
        "perf_event_open",
        "add_key",
        "request_key",
        "keyctl",
        "setns",
        "unshare",
        "mknod",
        "mknodat",
        "iopl",
        "ioperm",
        "create_module",
        "get_kernel_syms",
        "query_module",
        "nfsservctl",
        "process_vm_readv",
        "process_vm_writev"
      ],
      "action": "SCMP_ACT_LOG",
      "comment": "Log (do not block) dangerous syscalls so safety tests can observe real attempts."
    }
  ]
}
